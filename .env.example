# Sentinel Platform Environment Variables Template
# Copy this file to .env and configure for your environment

# Database Configuration
DB_NAME=sentinel
DB_USERNAME=sentinel
DB_PASSWORD=sentinel_password
DB_ROOT_PASSWORD=root_password
DB_PORT=3307

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Tokens
JWT_SECRET=your-secure-256-bit-secret-key-replace-in-production
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Gateway Policies
GATEWAY_TIMEOUT_MS=5000
GATEWAY_MAX_BODY_SIZE=10485760
GATEWAY_MAX_HEADER_SIZE=16384

# AI Assistant (Google Gemini - Optional)
GEMINI_API_KEY=your_gemini_api_key_here

